# ─────────────────────────────────────────────────────────────────────────────
# sdd-harness.env — SDD Harness Kit configuration contract
#
# This is the ONLY file that changes between projects. The hooks load it at
# startup and the skills read it as dynamic context. If a value does not apply to
# your project, leave it empty: the kit degrades without breaking.
#
# Format rules: KEY="value" on a single line. No commands, no backticks,
# no substitutions. It is loaded with a safe allowlist (no source/eval of the file).
# ─────────────────────────────────────────────────────────────────────────────

# Stack identifier. Informational only, appears in the session context.
STACK="generic"

# ── Commands ─────────────────────────────────────────────────────────────────
# Full test suite.
CMD_TEST=""
# Run a subset. Invoked as: $CMD_TEST_FILTER "<pattern>"
CMD_TEST_FILTER=""
# Project linter/formatter over the entire codebase.
CMD_LINT=""
# Format/fix a SINGLE file. Invoked as: $CMD_FORMAT_FILE "<path>"
CMD_FORMAT_FILE=""
# Static analysis on a SINGLE file. Invoked as: $CMD_STATIC_FILE "<path>"
CMD_STATIC_FILE=""
# Static analysis / type checking for the whole project.
CMD_STATIC=""
# Mutation testing over the critical paths.
CMD_MUTATION=""
# Documentation coverage of the public layers.
CMD_DOCS_COVERAGE=""
# Start the development environment.
CMD_DEV=""
# Apply migrations.
CMD_MIGRATE=""

# ── Project paths ────────────────────────────────────────────────────────────
# Source file extensions, space-separated and without a leading dot.
SOURCE_EXTENSIONS=""
# Root directory of production code.
PATH_SOURCE=""
# Test directory.
PATH_TESTS=""
# Layer where business logic lives.
PATH_BUSINESS=""
# Layer that speaks HTTP (controllers, handlers, resolvers).
PATH_HTTP=""
# Database migrations. Empty if the project has none.
PATH_MIGRATIONS=""
# Architecture decision record log.
PATH_ADR="docs/adr"

# ── Architecture guards ──────────────────────────────────────────────────────
# Extended regular expression (grep -E). If it appears in a
# PATH_BUSINESS file, the hook warns: the business layer must not know about HTTP.
GUARD_HTTP_IN_BUSINESS=""
# If it appears in a PATH_HTTP file, the hook warns: the HTTP layer must not
# query the database directly.
GUARD_DB_IN_HTTP=""
# Additional pattern of stack-specific dangerous commands, for the Bash
# PreToolUse hook. Appended to the kit's universal list.
GUARD_DANGEROUS_CMD=""

# ── Conventions ──────────────────────────────────────────────────────────────
# Layer order of a vertical unit of work. The skills use it to
# enforce the same path every time.
LAYER_ORDER="test → validation → model → business → interface → route"
# Mutation score threshold required on critical paths.
MIN_MUTATION_SCORE="70"
# Branch prefix that validate-tasks requires to see in Step 0 of tasks.md.
BRANCH_PREFIX="feature/"
# Escape hatches (local spikes). Remove before the PR.
# KIT_SKIP_STOP_TESTS="0"
# KIT_ALLOW_WIP="0"
