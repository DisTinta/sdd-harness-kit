# ─────────────────────────────────────────────────────────────────────────────
# sdd-harness.env — contrato de configuración del SDD Harness Kit
#
# Este es el ÚNICO fichero que cambia entre proyectos. Los hooks lo cargan al
# arrancar y las skills lo leen como contexto dinámico. Si un valor no aplica a
# tu proyecto, déjalo vacío: el kit se degrada sin romperse.
#
# Reglas de formato: KEY="valor" en una sola línea. Sin comandos, sin backticks,
# sin sustituciones. Se carga con allowlist segura (sin source/eval del fichero).
# ─────────────────────────────────────────────────────────────────────────────

# Identificador del stack. Solo informativo, aparece en el contexto de sesión.
STACK="generico"

# ── Comandos ─────────────────────────────────────────────────────────────────
# Suite completa de tests.
CMD_TEST=""
# Ejecutar un subconjunto. Se invoca como: $CMD_TEST_FILTER "<patrón>"
CMD_TEST_FILTER=""
# Linter/formateador del proyecto sobre todo el código.
CMD_LINT=""
# Formatear/arreglar UN fichero. Se invoca como: $CMD_FORMAT_FILE "<ruta>"
CMD_FORMAT_FILE=""
# Análisis estático sobre UN fichero. Se invoca como: $CMD_STATIC_FILE "<ruta>"
CMD_STATIC_FILE=""
# Análisis estático / comprobación de tipos de todo el proyecto.
CMD_STATIC=""
# Mutation testing sobre los paths críticos.
CMD_MUTATION=""
# Cobertura de documentación de las capas públicas.
CMD_DOCS_COVERAGE=""
# Arrancar el entorno de desarrollo.
CMD_DEV=""
# Aplicar migraciones.
CMD_MIGRATE=""

# ── Rutas del proyecto ───────────────────────────────────────────────────────
# Extensiones de los ficheros de código fuente, separadas por espacios y sin punto.
SOURCE_EXTENSIONS=""
# Directorio raíz del código de producción.
PATH_SOURCE=""
# Directorio de los tests.
PATH_TESTS=""
# Capa donde vive la lógica de negocio.
PATH_BUSINESS=""
# Capa que habla HTTP (controllers, handlers, resolvers).
PATH_HTTP=""
# Migraciones de base de datos. Vacío si el proyecto no tiene.
PATH_MIGRATIONS=""
# Registro de decisiones de arquitectura.
PATH_ADR="docs/adr"

# ── Guardas de arquitectura ──────────────────────────────────────────────────
# Expresión regular extendida (grep -E). Si aparece en un fichero de
# PATH_BUSINESS, el hook avisa: la capa de negocio no debe conocer HTTP.
GUARD_HTTP_IN_BUSINESS=""
# Si aparece en un fichero de PATH_HTTP, el hook avisa: la capa HTTP no debe
# consultar la base de datos directamente.
GUARD_DB_IN_HTTP=""
# Patrón adicional de comandos peligrosos propios del stack, para el hook
# PreToolUse de Bash. Se añade a la lista universal del kit.
GUARD_DANGEROUS_CMD=""

# ── Convenciones ─────────────────────────────────────────────────────────────
# Orden de capas de una unidad vertical de trabajo. Lo usan las skills para
# imponer el mismo recorrido siempre.
LAYER_ORDER="test → validación → modelo → negocio → interfaz → ruta"
# Umbral de mutation score exigido en paths críticos.
MIN_MUTATION_SCORE="70"
# Prefijo de rama que validate-tasks exige ver en el Step 0 de tasks.md.
BRANCH_PREFIX="feature/"
# Escape hatches (spikes locales). Quitar antes del PR.
# KIT_SKIP_STOP_TESTS="0"
# KIT_ALLOW_WIP="0"
