# SDD Harness Kit adapter — Laravel (PHP + Eloquent + Form Requests + Pest)
STACK="laravel"

CMD_TEST="php artisan test"
CMD_TEST_FILTER="php artisan test --filter"
CMD_LINT="vendor/bin/pint --test"
CMD_FORMAT_FILE="vendor/bin/pint --quiet"
CMD_STATIC_FILE="vendor/bin/phpstan analyse --no-progress --error-format=raw"
CMD_STATIC="vendor/bin/phpstan analyse --no-progress"
CMD_MUTATION="vendor/bin/infection run --test-framework=phpunit --no-progress"
CMD_DOCS_COVERAGE="vendor/bin/phpcs --standard=phpcs.docs.xml"
CMD_DEV="php artisan serve"
CMD_MIGRATE="php artisan migrate"

SOURCE_EXTENSIONS="php"
PATH_SOURCE="app"
PATH_TESTS="tests"
PATH_BUSINESS="app/Services"
PATH_HTTP="app/Http/Controllers"
PATH_MIGRATIONS="database/migrations"
PATH_ADR="docs/adr"

GUARD_HTTP_IN_BUSINESS="Illuminate\\\\Http\\\\Request|JsonResponse|response\("
GUARD_DB_IN_HTTP="::(where|query|firstOrFail|all)\(|\\\$request->all\("
GUARD_DANGEROUS_CMD="php[[:space:]]+artisan[[:space:]]+(migrate:(fresh|reset|refresh)|db:wipe|key:generate)"

LAYER_ORDER="test → enum → Form Request → model (Eloquent) → service → API Resource → controller → routes/api.php"
MIN_MUTATION_SCORE="70"
BRANCH_PREFIX="feature/"
KIT_SKIP_STOP_TESTS="0"
KIT_ALLOW_WIP="0"
# Spec/test protection: "1" asks before rewriting existing OpenSpec artifacts, tests,
# versioned migrations and kit doctrine. "0" stops asking (.env / '..' blocks stay on).
# Edit by hand; with "0" session start warns; do not commit as "0".
KIT_PROTECT_SPECS="1"
# Spec audit gate: "1" denies code/test edits until reports/*-spec-audit.md exists (§7.1).
# "0" = gate off. Edit by hand; do not commit as "0".
KIT_SPEC_AUDIT_GATE="1"
# OpenSpec archive retention (.claude/openspec-archive.sh, /openspec-archive skill; docs/en/CONFIG.en.md).
# INDEX.md: one row per archived change in openspec/changes/archive/INDEX.md. "1" = on.
KIT_ARCHIVE_INDEX="1"
# Delta pruning of openspec/changes/archive/<change>/specs/ after the archive commit:
#   deferred  = prune only deltas already on the default branch (safe with squash merges; default)
#   immediate = archive commit + separate prune commit in the same PR (merge-commit/rebase repos ONLY)
#   off       = never prune deltas
KIT_ARCHIVE_PRUNE_DELTAS="deferred"
# Folder pruning (separate command, dry run unless --apply). "1" = allowed. A folder is removed only
# if it is outside the newest KIT_ARCHIVE_KEEP AND older than KIT_ARCHIVE_MAX_AGE_DAYS days.
KIT_ARCHIVE_PRUNE_FOLDERS="0"
KIT_ARCHIVE_KEEP="50"
KIT_ARCHIVE_MAX_AGE_DAYS="180"
# Branch PRs merge into (deferred proof). Empty = origin/HEAD, else main. E.g. "origin/main".
KIT_ARCHIVE_DEFAULT_BRANCH=""
