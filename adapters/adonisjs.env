# SDD Harness Kit adapter — AdonisJS (TypeScript + Lucid + VineJS + Japa)
STACK="adonisjs"

CMD_TEST="node ace test"
CMD_TEST_FILTER="node ace test --files"
CMD_LINT="npm run lint"
CMD_FORMAT_FILE="npx biome check --write"
CMD_STATIC_FILE="npx tsc --noEmit"
CMD_STATIC="npm run typecheck"
CMD_MUTATION="npx stryker run"
CMD_DOCS_COVERAGE="npx typedoc --validation.notDocumented --logLevel Warn"
CMD_DEV="node ace serve --hmr"
CMD_MIGRATE="node ace migration:run"

SOURCE_EXTENSIONS="ts tsx"
PATH_SOURCE="app"
PATH_TESTS="tests"
PATH_BUSINESS="app/services"
PATH_HTTP="app/controllers"
PATH_MIGRATIONS="database/migrations"
PATH_ADR="docs/adr"

GUARD_HTTP_IN_BUSINESS="@adonisjs/core/http|HttpContext"
GUARD_DB_IN_HTTP="\.(where|query|firstOrFail|createMany)\("
GUARD_DANGEROUS_CMD="node[[:space:]]+ace[[:space:]]+(migration:(fresh|reset)|db:wipe)"

LAYER_ORDER="test → validator (VineJS) → model (Lucid) → service → controller → start/routes.ts"
MIN_MUTATION_SCORE="70"
BRANCH_PREFIX="feature/"
KIT_SKIP_STOP_TESTS="0"
KIT_ALLOW_WIP="0"
