# Adaptador SDD Harness Kit — Fastify (TypeScript + Zod + Vitest, monorepo hexagonal)
#
# Asume la disposición de un monorepo con workspaces de npm y arquitectura
# hexagonal: el dominio en packages/core, los adaptadores fuera, y la capa HTTP
# como un adaptador más. Si tu proyecto es un Fastify de un solo paquete,
# ajusta PATH_* y las guardas: los comandos valen igual.
STACK="fastify"

CMD_TEST="npx vitest run"
CMD_TEST_FILTER="npx vitest run"
CMD_LINT="npm run lint"
CMD_FORMAT_FILE="npx eslint --fix"
CMD_STATIC_FILE="npx tsc --noEmit"
CMD_STATIC="npm run typecheck"
CMD_MUTATION="npx stryker run"
CMD_DOCS_COVERAGE="npx typedoc --validation.notDocumented --logLevel Warn"
CMD_DEV="npm run dev"
CMD_MIGRATE="npm run db:migrate"

SOURCE_EXTENSIONS="ts tsx"
PATH_SOURCE="packages"
PATH_TESTS="tests"
PATH_BUSINESS="packages/core"
PATH_HTTP="packages/api"
PATH_MIGRATIONS="packages/adapters/store-postgres/migrations"
PATH_ADR="docs/adr"

# El dominio no conoce el transporte NI la infraestructura. La segunda mitad de
# esta expresión es la regla de dependencias del monorepo: si el nombre de un
# paquete de infraestructura aparece en un fichero de packages/core, el hook
# avisa. Es la misma regla que dependency-cruiser comprueba en CI, aplicada
# antes, en el momento de escribir el fichero.
GUARD_HTTP_IN_BUSINESS="fastify|FastifyRequest|FastifyReply|node:http|(adapters|analyzers|store-postgres)/"
# La capa HTTP valida, delega y serializa. No consulta la base de datos.
GUARD_DB_IN_HTTP="new[[:space:]]+Pool|\.query\(|SELECT[[:space:]]|INSERT[[:space:]]+INTO|UPDATE[[:space:]]+[a-z_]+[[:space:]]+SET"
# Destruir el grafo indexado cuesta un reindexado completo: no es reversible en frío.
GUARD_DANGEROUS_CMD="npm[[:space:]]+run[[:space:]]+db:(reset|drop|wipe)|docker[[:space:]]+compose[[:space:]]+down[[:space:]]+.*-v|DROP[[:space:]]+(DATABASE|TABLE|SCHEMA)"

LAYER_ORDER="test → puerto (core/ports) → dominio (core) → adaptador → esquema Zod (api) → ruta (api)"
MIN_MUTATION_SCORE="70"
BRANCH_PREFIX="feature/"
KIT_SKIP_STOP_TESTS="0"
KIT_ALLOW_WIP="0"
